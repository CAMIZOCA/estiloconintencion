---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" noindex>
  <section class="seccion">
    <div class="contenedor" style="text-align:center">
      <p class="kicker">Error 404</p>
      <h1>Esta página <em>no existe</em></h1>
      <p class="entrada" style="margin-inline:auto">Puede que el enlace esté incompleto o que la página haya cambiado.</p>
      <div class="acciones" style="justify-content:center">
        <a class="boton" href="/">Ir al inicio</a>
        <a class="boton boton--linea" href="/servicios">Ver servicios</a>
      </div>
    </div>
  </section>
</Base>
